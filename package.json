{
  "name": "super-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Draft orchestrator: Grok Bot drives Herdr Core agents through gbb, using a dsh-superagent-style mandate and evidence gate.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sbot": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' vitest run",
    "lint": "eslint src tests",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "demo": "tsx src/cli.ts demo",
    "serve": "tsx src/cli.ts serve --port 47231",
    "smoke": "tsx src/cli.ts smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.3",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
